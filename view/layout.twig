<!DOCTYPE html>
<html>
<head>
    <title>{{ title|default('Lychee Admin') }}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <link rel="icon" type="image/png" href="{{ asset('lychee/admin/images/logo.png') }}">
    <link rel="stylesheet" href="{{ asset('lychee/component/pear/css/pear.css') }}" />
    <link rel="stylesheet" href="{{ asset('lychee/admin/css/variables.css') }}" />
    <link rel="stylesheet" href="{{ asset('lychee/admin/css/reset.css') }}" />
    <link rel="stylesheet" href="{{ asset('lychee/admin/css/admin.css') }}" />
    <link rel="stylesheet" href="{{ asset('lychee/admin/css/admin.dark.css') }}" />
</head>
<body class="layui-layout-body pear-admin">
    <div class="layui-layout layui-layout-admin">

        {# 顶部导航 #}
        <div class="layui-header">
            <div class="layui-logo">
                <img class="logo" src="{{ asset('lychee/admin/images/logo.png') }}">
                <span class="title">Lychee Admin</span>
            </div>
            <ul class="layui-nav layui-layout-left">
                <li class="collapse layui-nav-item"><a href="#" class="layui-icon layui-icon-shrink-right"></a></li>
                <li class="refresh layui-nav-item"><a href="#" class="layui-icon layui-icon-refresh-1" loading="600"></a></li>
            </ul>
            <ul class="layui-nav layui-layout-right">
                <li class="layui-nav-item layui-hide-xs"><a href="#" class="fullScreen layui-icon layui-icon-screen-full"></a></li>
                <li class="layui-nav-item layui-hide-xs message" lay-unselect></li>
                <li class="layui-nav-item layui-hide-xs"><a href="#" id="theme-toggle" class="layui-icon layui-icon-moon" title="切换夜间模式"></a></li>
                <li class="layui-nav-item layui-hide-xs"><a href="#" class="setting layui-icon layui-icon-theme"></a></li>
                <li class="layui-nav-item user">
                    <a class="layui-icon layui-icon-username" href="javascript:;"></a>
                    <dl class="layui-nav-child">
                        <dd><a href="javascript:void(0);" class="logout">注销登录</a></dd>
                    </dl>
                </li>
            </ul>
        </div>

        {# 侧边栏 #}
        <div class="layui-side layui-bg-black">
            <div class="layui-logo">
                <img class="logo" src="{{ asset('lychee/admin/images/logo.png') }}">
                <span class="title">Lychee Admin</span>
            </div>
            <div class="layui-side-scroll">
                <div id="side"></div>
            </div>
        </div>

        {# 内容区（由 pear-admin tabPage 管理） #}
        <div class="layui-body">
            <div id="content"></div>
        </div>

        <div class="layui-footer layui-text">Copyright © 2026 Lychee Admin</div>

        <div class="pear-cover"></div>
        <div class="loader-wrapper">
            <div class="loader"></div>
        </div>
    </div>

    <div class="pear-collapsed-pe collapse">
        <a href="#" class="layui-icon layui-icon-shrink-right"></a>
    </div>

    <script src="{{ asset('lychee/component/layui/layui.js') }}"></script>
    <script src="{{ asset('lychee/component/pear/pear.js') }}"></script>
    <script>
        // 构建 pear-admin 菜单数据
        var menuData = [
            {
                id: 'dashboard',
                title: '仪表盘',
                icon: 'layui-icon layui-icon-console',
                type: 1,
                href: '/admin/dashboard',
                openType: '_component'
            }
            {% for group, items in menu %}
            ,{
                id: 'group-{{ loop.index }}',
                title: '{{ group }}',
                icon: 'layui-icon layui-icon-app',
                type: 0,
                children: [
                    {% for item in items %}
                    {
                        id: '{{ item.model|split('\\')|last|lower }}',
                        title: '{{ item.title }}',
                        icon: '{{ item.icon ?: 'layui-icon layui-icon-face-smile' }}',
                        type: 1,
                        href: '/admin/{{ item.model|split('\\')|last|lower }}',
                        openType: '_component'
                    }{% if not loop.last %},{% endif %}
                    {% endfor %}
                ]
            }
            {% endfor %}
        ];

        // pear-admin 配置
        var pearConfig = {
            logo: {
                image: '{{ asset('lychee/admin/images/logo.png') }}',
                title: 'Lychee Admin'
            },
            menu: {
                data: menuData,
                async: false,
                method: 'GET',
                accordion: true,
                control: false,
                collapse: false,
                select: 'dashboard'
            },
            header: {
                message: '/admin/notifications'
            },
            tab: {
                index: {
                    id: 'dashboard',
                    href: '/admin/dashboard',
                    title: '仪表盘'
                },
                enable: true,
                session: false,
                max: 20,
                preload: false,
                keepState: false
            },
            theme: {
                defaultColor: 'default',
                defaultMenu: 'dark-theme',
                defaultHeader: 'light-theme',
                dark: false,
                allowCustom: true
            },
            colors: [
                { id: 'default', color: '#D6336C', second: '#D6336C' },
                { id: 'blue', color: '#1E9FFF', second: '#1E9FFF' },
                { id: 'green', color: '#16BAAA', second: '#16BAAA' },
                { id: 'red', color: '#FF5722', second: '#FF5722' },
                { id: 'orange', color: '#FFB800', second: '#FFB800' },
                { id: 'purple', color: '#A233C6', second: '#A233C6' }
            ],
            other: {
                keepLoad: 200,
                autoHead: false,
                footer: true
            }
        };

        layui.use(['admin', 'popup', 'jquery'], function () {
            var admin = layui.admin;
            var popup = layui.popup;
            var $ = layui.jquery;

            // 注销逻辑
            admin.logout(function () {
                return new Promise(function (resolve) {
                    fetch('/admin/logout', { method: 'POST' })
                        .then(function (r) { return r.json(); })
                        .then(function () {
                            popup.success('注销成功', function () {
                                location.href = '/admin/login';
                            });
                            resolve(true);
                        })
                        .catch(function () { resolve(false); });
                });
            });

            // 启动 pear-admin
            admin.render(pearConfig);

            // 主题切换（日间/夜间模式）
            (function () {
                var $toggle = $('#theme-toggle');
                var isDark = localStorage.getItem('dark') === 'true';

                function syncIcon() {
                    isDark = localStorage.getItem('dark') === 'true';
                    if (isDark) {
                        $toggle.removeClass('layui-icon-moon').addClass('layui-icon-light');
                        $toggle.attr('title', '切换日间模式');
                    } else {
                        $toggle.removeClass('layui-icon-light').addClass('layui-icon-moon');
                        $toggle.attr('title', '切换夜间模式');
                    }
                }

                // 初始化图标
                syncIcon();

                $toggle.on('click', function (e) {
                    e.preventDefault();
                    isDark = !isDark;
                    localStorage.setItem('dark', isDark);
                    admin.switchTheme(isDark);
                    syncIcon();
                });
            })();
        });
    </script>
</body>
</html>
