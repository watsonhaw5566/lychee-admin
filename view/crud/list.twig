{% set resource = admin.getModel()|split('\\')|last|lower %}
<div class="pear-container">
    <div class="layui-card">
        <div class="layui-card-header">{{ admin.getTitle() }}</div>
        <div class="layui-card-body">
            {# 搜索栏 #}
            {% if admin.getSearchFields() is not empty %}
            <div class="layui-form" style="margin-bottom:15px;">
                <div class="layui-inline">
                    {% for field in admin.getSearchFields() %}
                    <input type="text" name="{{ field }}" placeholder="{{ admin.getFieldLabel(field) }}" class="layui-input search-input" style="width:150px;display:inline-block;margin-right:10px;">
                    {% endfor %}
                    <button class="layui-btn" id="search-btn-{{ resource }}">搜索</button>
                    <button class="layui-btn layui-btn-primary" id="reset-btn-{{ resource }}">重置</button>
                </div>
            </div>
            {% endif %}

            {# 操作栏 #}
            <div style="margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;">
                <div>
                    {% if admin.canCreate() %}
                    <button class="layui-btn layui-btn-sm" id="create-btn-{{ resource }}">
                        <i class="layui-icon layui-icon-add-1"></i> 新增
                    </button>
                    {% endif %}
                    {% if admin.canDelete() %}
                    <button class="layui-btn layui-btn-sm layui-btn-danger" id="batch-delete-btn-{{ resource }}">
                        <i class="layui-icon layui-icon-delete"></i> 批量删除
                    </button>
                    {% endif %}
                </div>
                <div>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" id="refresh-btn-{{ resource }}">
                        <i class="layui-icon layui-icon-refresh"></i> 刷新
                    </button>
                </div>
            </div>

            {# 数据表格 #}
            <table id="table-{{ resource }}" lay-filter="table-{{ resource }}"></table>
        </div>
    </div>
</div>

{# 操作列模板 #}
<script type="text/html" id="bar-{{ resource }}">
    {% if admin.canUpdate() %}
    <a class="layui-btn layui-btn-sm" lay-event="edit">编辑</a>
    {% endif %}
    {% if admin.canDelete() %}
    <a class="layui-btn layui-btn-sm layui-btn-danger" lay-event="del">删除</a>
    {% endif %}
</script>

<script>
layui.use(['jquery', 'layer', 'table', 'admin'], function () {
    var $ = layui.jquery;
    var layer = layui.layer;
    var table = layui.table;
    var admin = layui.admin;

    var resource = '{{ resource }}';
    var title = '{{ admin.getTitle() }}';

    var cols = [
        {% if admin.canDelete() %}
        {type: 'checkbox', fixed: 'left'},
        {% endif %}
        {% for field in admin.getListFields() %}
        {% set fieldConfig = admin.getFormFields()[field] ?? null %}
        {% set fieldType = fieldConfig is iterable ? (fieldConfig.type ?? 'text') : (fieldConfig ?? 'text') %}
        {% if fieldType == 'image' %}
        {field: '{{ field }}', title: '{{ admin.getFieldLabel(field) }}', templet: function (d) {
            var v = d['{{ field }}'] || '';
            var urls = [];
            if (v) {
                try {
                    var parsed = JSON.parse(v);
                    urls = Array.isArray(parsed) ? parsed : [v];
                } catch (e) { urls = [v]; }
            }
            if (urls.length) {
                return urls.map(function (u) {
                    return u ? '<img src="' + u + '" class="list-thumb" onclick="layer.photos({photos:{data:[{src:\'' + u + '\'}]}})">' : '';
                }).join('');
            }
            return '';
        }},
        {% else %}
        {field: '{{ field }}', title: '{{ admin.getFieldLabel(field) }}'},
        {% endif %}
        {% endfor %}
        {title: '操作', toolbar: '#bar-{{ resource }}', width: 200, fixed: 'right'}
    ];

    table.render({
        elem: '#table-' + resource,
        url: '/admin/' + resource + '/data',
        page: true,
        limit: 20,
        limits: [10, 20, 50, 100],
        cols: [cols],
        skin: 'line'
    });

    // 行工具事件
    table.on('tool(table-' + resource + ')', function (obj) {
        var data = obj.data;
        if (obj.event === 'edit') {
            admin.changePage({
                id: resource + '-edit-' + data.id,
                title: '编辑' + title,
                url: '/admin/' + resource + '/' + data.id + '/edit',
                type: '_component',
                close: true
            });
        } else if (obj.event === 'del') {
            layer.confirm('确定删除？', {icon: 3, title: '提示'}, function (index) {
                fetch('/admin/' + resource + '/' + data.id, {method: 'DELETE'})
                    .then(function (r) { return r.json(); })
                    .then(function (res) {
                        layer.close(index);
                        if (res.code === 200) {
                            layer.msg('删除成功', {icon: 1});
                            table.reload('table-' + resource);
                        } else {
                            layer.msg(res.msg || '删除失败', {icon: 2});
                        }
                    });
            });
        }
    });

    // 新增
    document.getElementById('create-btn-' + resource)?.addEventListener('click', function () {
        admin.changePage({
            id: resource + '-create',
            title: '新增' + title,
            url: '/admin/' + resource + '/create',
            type: '_component',
            close: true
        });
    });

    // 刷新
    document.getElementById('refresh-btn-' + resource)?.addEventListener('click', function () {
        table.reload('table-' + resource);
    });

    // 搜索
    document.getElementById('search-btn-' + resource)?.addEventListener('click', function () {
        var where = {};
        document.querySelectorAll('.pear-container .search-input').forEach(function (input) {
            if (input.value) where[input.name] = input.value;
        });
        table.reload('table-' + resource, {where: where, page: {curr: 1}});
    });

    // 重置
    document.getElementById('reset-btn-' + resource)?.addEventListener('click', function () {
        document.querySelectorAll('.pear-container .search-input').forEach(function (i) { i.value = ''; });
        table.reload('table-' + resource, {where: {}, page: {curr: 1}});
    });

    // 批量删除
    document.getElementById('batch-delete-btn-' + resource)?.addEventListener('click', function () {
        var checkStatus = table.checkStatus('table-' + resource);
        var ids = checkStatus.data.map(function (row) { return row.id; });
        if (ids.length === 0) {
            layer.msg('请先选择要删除的数据', {icon: 0});
            return;
        }
        layer.confirm('确定删除选中的 ' + ids.length + ' 条数据？', {icon: 3, title: '提示'}, function (index) {
            var params = new URLSearchParams();
            ids.forEach(function (id) { params.append('ids[]', id); });
            fetch('/admin/' + resource + '/batch', {
                method: 'DELETE',
                headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                body: params.toString()
            })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    layer.close(index);
                    if (res.code === 200) {
                        layer.msg(res.msg || '删除成功', {icon: 1});
                        table.reload('table-' + resource);
                    } else {
                        layer.msg(res.msg || '删除失败', {icon: 2});
                    }
                });
        });
    });
});
</script>
