{% set resource = admin.getModel()|split('\\')|last|lower %}
<div class="pear-container">
    <div class="layui-card">
        <div class="layui-card-header">{{ admin.getTitle() }}</div>
        <div class="layui-card-body">
            {# 搜索栏 #}
            {% if admin.getSearchFields() is not empty %}
            <div class="layui-form" style="margin-bottom:15px;">
                <div class="layui-inline">
                    {% for field in admin.getSearchFields() %}
                    <input type="text" name="{{ field }}" placeholder="{{ admin.getFieldLabel(field) }}" class="layui-input search-input" style="width:150px;display:inline-block;margin-right:10px;">
                    {% endfor %}
                    <button class="layui-btn" id="search-btn-{{ resource }}">搜索</button>
                    <button class="layui-btn layui-btn-primary" id="reset-btn-{{ resource }}">重置</button>
                </div>
            </div>
            {% endif %}

            {# 操作栏 #}
            <div style="margin-bottom:10px;">
                {% if admin.canCreate() %}
                <button class="layui-btn layui-btn-sm" id="create-btn-{{ resource }}">
                    <i class="layui-icon layui-icon-add-1"></i> 新增
                </button>
                {% endif %}
                {% if admin.canDelete() %}
                <button class="layui-btn layui-btn-sm layui-btn-danger" id="batch-delete-btn-{{ resource }}">
                    <i class="layui-icon layui-icon-delete"></i> 批量删除
                </button>
                {% endif %}
            </div>

            {# 数据表格 #}
            <div class="layui-form">
            <table class="layui-table" lay-size="sm">
                <thead>
                    <tr>
                        {% if admin.canDelete() %}
                        <th style="width:40px;text-align:center;">
                            <input type="checkbox" id="check-all-{{ resource }}" lay-skin="primary" lay-filter="checkAll-{{ resource }}">
                        </th>
                        {% endif %}
                        {% for field in admin.getListFields() %}
                        <th>{{ admin.getFieldLabel(field) }}</th>
                        {% endfor %}
                        <th style="width:160px;">操作</th>
                    </tr>
                </thead>
                <tbody id="data-body-{{ resource }}"></tbody>
            </table>
            </div>

            {# 分页 #}
            <div id="pagination-{{ resource }}"></div>
        </div>
    </div>
</div>

<script>
layui.use(['jquery', 'layer', 'laypage', 'admin', 'form'], function () {
    var $ = layui.jquery;
    var layer = layui.layer;
    var laypage = layui.laypage;
    var admin = layui.admin;
    var form = layui.form;

    var resource = '{{ resource }}';
    var title = '{{ admin.getTitle() }}';
    var canDelete = {{ admin.canDelete() ? 'true' : 'false' }};
    var currentPage = 1;
    var pageSize = 20;

    function loadData() {
        var loadIndex = layer.open({
            type: 1,
            shade: 0,
            area: ['120px', '80px'],
            closeBtn: 0,
            title: false,
            shadeClose: false,
            skin: 'pear-loading-layer',
            content: '<div class="ball-loader"><span></span><span></span><span></span><span></span></div>'
        });
        var params = new URLSearchParams();
        params.append('page', currentPage);
        params.append('limit', pageSize);

        document.querySelectorAll('#data-body-' + resource + ' ~ .search-input, .pear-container .search-input').forEach(function (input) {
            if (input.value) params.append(input.name, input.value);
        });

        fetch('/admin/' + resource + '/data?' + params.toString())
            .then(function (r) { return r.json(); })
            .then(function (res) {
                layer.close(loadIndex);
                var tbody = document.getElementById('data-body-' + resource);
                if (!tbody) return;
                tbody.innerHTML = '';
                $('#check-all-' + resource).prop('checked', false);
                if (res.data && res.data.length) {
                    res.data.forEach(function (row) {
                        var tr = '<tr>';
                        if (canDelete) {
                            tr += '<td style="text-align:center;"><input type="checkbox" class="row-check" value="' + row.id + '" lay-skin="primary" lay-filter="rowCheck-' + resource + '"></td>';
                        }
                        {% for field in admin.getListFields() %}
                        tr += '<td>' + (row['{{ field }}'] ?? '') + '</td>';
                        {% endfor %}
                        tr += '<td>';
                        {% if admin.canUpdate() %}
                        tr += '<button class="layui-btn layui-btn-xs" onclick="editItem_{{ resource }}(' + row.id + ')">编辑</button> ';
                        {% endif %}
                        {% if admin.canDelete() %}
                        tr += '<button class="layui-btn layui-btn-xs layui-btn-danger" onclick="delItem_{{ resource }}(' + row.id + ')">删除</button>';
                        {% endif %}
                        tr += '</td></tr>';
                        tbody.innerHTML += tr;
                    });
                    form.render('checkbox');
                } else {
                    tbody.innerHTML = '<tr><td colspan="{{ admin.canDelete() ? admin.getListFields()|length + 2 : admin.getListFields()|length + 1 }}" style="text-align:center;">暂无数据</td></tr>';
                }
                renderPagination(res.count || 0);
            })
            .catch(function () {
                layer.close(loadIndex);
            });
    }

    window['editItem_{{ resource }}'] = function (id) {
        admin.changePage({
            id: resource + '-edit-' + id,
            title: '编辑' + title,
            url: '/admin/' + resource + '/' + id + '/edit',
            type: '_component'
        });
    };

    window['delItem_{{ resource }}'] = function (id) {
        layer.confirm('确定删除？', { icon: 3, title: '提示' }, function (index) {
            fetch('/admin/' + resource + '/' + id, { method: 'DELETE' })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    layer.close(index);
                    if (res.code === 200) {
                        layer.msg('删除成功', { icon: 1 });
                        admin.instances.tabPage.refresh(false);
                    } else {
                        layer.msg(res.msg || '删除失败', { icon: 2 });
                    }
                });
        });
    };

    // 全选 / 取消全选
    form.on('checkbox(checkAll-' + resource + ')', function (data) {
        $('#data-body-' + resource + ' .row-check').prop('checked', data.elem.checked);
        form.render('checkbox');
    });

    // 单个勾选变化时反向同步全选框
    form.on('checkbox(rowCheck-' + resource + ')', function () {
        syncCheckAll();
    });

    // 检查所有行 checkbox 是否全部选中，同步全选框状态
    function syncCheckAll() {
        var $rows = $('#data-body-' + resource + ' .row-check');
        if ($rows.length === 0) {
            $('#check-all-' + resource).prop('checked', false);
        } else {
            var allChecked = $rows.length === $rows.filter(':checked').length;
            $('#check-all-' + resource).prop('checked', allChecked);
        }
        form.render('checkbox');
    }

    // 批量删除
    document.getElementById('batch-delete-btn-' + resource)?.addEventListener('click', function () {
        var ids = [];
        document.querySelectorAll('#data-body-' + resource + ' .row-check:checked').forEach(function (cb) {
            ids.push(cb.value);
        });
        if (ids.length === 0) {
            layer.msg('请先选择要删除的数据', { icon: 0 });
            return;
        }
        layer.confirm('确定删除选中的 ' + ids.length + ' 条数据？', { icon: 3, title: '提示' }, function (index) {
            var params = new URLSearchParams();
            ids.forEach(function (id) { params.append('ids[]', id); });
            fetch('/admin/' + resource + '/batch', {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: params.toString()
            })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    layer.close(index);
                    if (res.code === 200) {
                        layer.msg(res.msg || '删除成功', { icon: 1 });
                        admin.instances.tabPage.refresh(false);
                    } else {
                        layer.msg(res.msg || '删除失败', { icon: 2 });
                    }
                });
        });
    });

    function renderPagination(count) {
        laypage.render({
            elem: 'pagination-' + resource,
            count: count,
            curr: currentPage,
            limit: pageSize,
            layout: ['prev', 'page', 'next', 'count'],
            jump: function (obj, first) {
                if (!first) {
                    currentPage = obj.curr;
                    loadData();
                }
            }
        });
    }

    document.getElementById('create-btn-' + resource)?.addEventListener('click', function () {
        admin.changePage({
            id: resource + '-create',
            title: '新增' + title,
            url: '/admin/' + resource + '/create',
            type: '_component'
        });
    });

    document.getElementById('search-btn-' + resource)?.addEventListener('click', function () {
        currentPage = 1;
        loadData();
    });

    document.getElementById('reset-btn-' + resource)?.addEventListener('click', function () {
        document.querySelectorAll('.pear-container .search-input').forEach(function (i) { i.value = ''; });
        currentPage = 1;
        loadData();
    });

    loadData();
});
</script>
