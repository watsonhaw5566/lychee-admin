{% set resource = admin.getModel()|split('\\')|last|lower %}
<div class="pear-container">
    <div class="layui-card">
        <div class="layui-card-header">{{ title }}</div>
        <div class="layui-card-body">
            <form class="layui-form" id="crud-form-{{ resource }}" style="max-width:600px;">
                {% for field, config in admin.getFormFields() %}
                <div class="layui-form-item">
                    <label class="layui-form-label">{{ admin.getFieldLabel(field) }}</label>
                    <div class="layui-input-block">
                        {% set type = config is iterable ? (config.type ?? 'text') : (config ?? 'text') %}
                        {% set value = data[field] ?? '' %}

                        {% if type == 'textarea' %}
                        <textarea name="{{ field }}" class="layui-textarea">{{ value }}</textarea>

                        {% elseif type == 'select' %}
                        <select name="{{ field }}">
                            {% for val, label in config.options ?? {} %}
                            <option value="{{ val }}" {% if value == val %}selected{% endif %}>{{ label }}</option>
                            {% endfor %}
                        </select>

                        {% elseif type == 'radio' %}
                        {% for val, label in config.options ?? {} %}
                        <input type="radio" name="{{ field }}" value="{{ val }}" title="{{ label }}" {% if value == val %}checked{% endif %}>
                        {% endfor %}

                        {% elseif type == 'checkbox' %}
                        {% for val, label in config.options ?? {} %}
                        <input type="checkbox" name="{{ field }}[]" value="{{ val }}" title="{{ label }}" lay-skin="primary">
                        {% endfor %}

                        {% elseif type == 'switch' %}
                        <input type="checkbox" name="{{ field }}" lay-skin="switch" {% if value %}checked{% endif %}>

                        {% elseif type == 'password' %}
                        <input type="password" name="{{ field }}" value="" class="layui-input" placeholder="{% if action == 'edit' %}留空不修改{% endif %}">

                        {% elseif type == 'number' %}
                        <input type="number" name="{{ field }}" value="{{ value }}" class="layui-input">

                        {% else %}
                        <input type="text" name="{{ field }}" value="{{ value }}" class="layui-input">
                        {% endif %}
                    </div>
                </div>
                {% endfor %}

                <div class="layui-form-item">
                    <div class="layui-input-block">
                        <button type="submit" class="layui-btn">保存</button>
                        <button type="button" class="layui-btn layui-btn-primary" id="back-btn-{{ resource }}">返回</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
layui.use(['jquery', 'form', 'layer', 'admin'], function () {
    var $ = layui.jquery;
    var form = layui.form;
    var layer = layui.layer;
    var admin = layui.admin;

    var resource = '{{ resource }}';
    var title = '{{ admin.getTitle() }}';
    var isEdit = {{ action == 'edit' ? 'true' : 'false' }};
    var editId = {{ data.id ?? 0 }};

    form.render();

    // 返回：关闭当前标签页，回到列表
    function backToList() {
        var currentTabId = $('.layui-tab[lay-filter="content"] .layui-tab-title .layui-this').attr('lay-id');
        admin.changePage({
            id: resource,
            title: title,
            url: '/admin/' + resource,
            type: '_component'
        });
        setTimeout(function () {
            admin.instances.tabPage.refresh(false);
            if (currentTabId) {
                admin.instances.tabPage.removeTab(currentTabId);
            }
        }, 200);
    }

    document.getElementById('back-btn-' + resource).addEventListener('click', backToList);

    document.getElementById('crud-form-' + resource).addEventListener('submit', function (e) {
        e.preventDefault();
        var formData = new FormData(this);
        var params = new URLSearchParams();
        for (var pair of formData.entries()) {
            if (pair[1] !== '') params.append(pair[0], pair[1]);
        }

        var url = isEdit ? '/admin/' + resource + '/' + editId : '/admin/' + resource;
        var method = isEdit ? 'PUT' : 'POST';

        fetch(url, {
            method: method,
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: params.toString()
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
            if (res.code === 200) {
                layer.msg('保存成功', { icon: 1, time: 800 }, function () {
                    backToList();
                });
            } else {
                layer.msg(res.msg || '保存失败', { icon: 2 });
            }
        })
        .catch(function () { layer.msg('网络错误', { icon: 2 }); });
    });
});
</script>
