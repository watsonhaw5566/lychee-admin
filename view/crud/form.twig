{% set resource = admin.getModel()|split('\\')|last|lower %}
{% set hasRichtext = false %}
{% for field, config in admin.getFormFields() %}
    {% set fieldType = config is iterable ? (config.type ?? 'text') : (config ?? 'text') %}
    {% if fieldType == 'richtext' %}{% set hasRichtext = true %}{% endif %}
{% endfor %}
<div class="pear-container">
    <div class="layui-card">
        <div class="layui-card-header">{{ title }}</div>
        <div class="layui-card-body">
            <form class="layui-form{% if hasRichtext %} form-with-richtext{% endif %}" lay-filter="crud-form-{{ resource }}" id="crud-form-{{ resource }}" style="{% if hasRichtext %}max-width:1000px;{% else %}max-width:600px;{% endif %}">
                {% for field, config in admin.getFormFields() %}
                {% set layVerify = admin.getFieldLayVerify(field) %}
                <div class="layui-form-item">
                    <label class="layui-form-label">
                        {{ admin.getFieldLabel(field) }}
                        {% if admin.isFieldRequired(field) %}<span style="color:#FF5722;margin-left:2px;">*</span>{% endif %}
                    </label>
                    <div class="layui-input-block">
                        {% set type = config is iterable ? (config.type ?? 'text') : (config ?? 'text') %}
                        {% set value = data[field] ?? '' %}

                        {% if type == 'textarea' %}
                        <textarea name="{{ field }}" class="layui-textarea"{% if layVerify %} lay-verify="{{ layVerify }}"{% endif %}>{{ value }}</textarea>

                        {% elseif type == 'select' %}
                        {% set isMultiple = config.multiple ?? false %}
                        <select name="{{ field }}{% if isMultiple %}[]{% endif %}" {% if isMultiple %}multiple{% endif %}{% if layVerify %} lay-verify="{{ layVerify }}"{% endif %}>
                            {% for val, label in config.options ?? {} %}
                            <option value="{{ val }}" {% if isMultiple %}{% if val in value %}selected{% endif %}{% else %}{% if value == val %}selected{% endif %}{% endif %}>{{ label }}</option>
                            {% endfor %}
                        </select>

                        {% elseif type == 'radio' %}
                        {% for val, label in config.options ?? {} %}
                        <input type="radio" name="{{ field }}" value="{{ val }}" title="{{ label }}" {% if value == val %}checked{% endif %}{% if layVerify and loop.first %} lay-verify="{{ layVerify }}"{% endif %}>
                        {% endfor %}

                        {% elseif type == 'checkbox' %}
                        {% for val, label in config.options ?? {} %}
                        <input type="checkbox" name="{{ field }}[]" value="{{ val }}" title="{{ label }}" lay-skin="primary" {% if val in value %}checked{% endif %}>
                        {% endfor %}

                        {% elseif type == 'switch' %}
                        <input type="checkbox" name="{{ field }}" lay-skin="switch" {% if value %}checked{% endif %}>

                        {% elseif type == 'password' %}
                        <input type="password" name="{{ field }}" value="" class="layui-input"{% if layVerify %} lay-verify="{{ layVerify }}"{% endif %} placeholder="{% if action == 'edit' %}留空不修改{% endif %}">

                        {% elseif type == 'number' %}
                        <input type="number" name="{{ field }}" value="{{ value }}" class="layui-input"{% if layVerify %} lay-verify="{{ layVerify }}"{% endif %}>

                        {% elseif type == 'date' %}
                        <input type="date" name="{{ field }}" value="{{ value }}" class="layui-input"{% if layVerify %} lay-verify="{{ layVerify }}"{% endif %}>

                        {% elseif type == 'image' %}
                        {% set isMultiple = config.multiple ?? false %}
                        {% set storedValue = value is iterable ? (value|json_encode|e('html_attr')) : (value|e('html_attr')) %}
                        <input type="hidden" name="{{ field }}" value="{{ storedValue }}" id="upload-value-{{ resource }}-{{ field }}">
                        <button type="button" class="layui-btn layui-btn-sm" id="upload-btn-{{ resource }}-{{ field }}"
                                data-field="{{ field }}" data-type="image" data-multiple="{{ isMultiple ? '1' : '0' }}">
                            <i class="layui-icon layui-icon-upload"></i> 上传图片
                        </button>
                        <div class="layui-upload-list upload-preview" id="upload-preview-{{ resource }}-{{ field }}">
                            {% if isMultiple %}
                                {% set imageList = value is iterable ? value : [] %}
                                {% for img in imageList %}
                                    {% if img %}
                                    <div class="upload-item" data-url="{{ img }}">
                                        <img src="{{ img }}" class="layui-upload-img">
                                        <a href="javascript:;" class="upload-del"><i class="layui-icon layui-icon-close"></i></a>
                                    </div>
                                    {% endif %}
                                {% endfor %}
                            {% else %}
                                {% if value %}
                                <div class="upload-item" data-url="{{ value }}">
                                    <img src="{{ value }}" class="layui-upload-img">
                                    <a href="javascript:;" class="upload-del"><i class="layui-icon layui-icon-close"></i></a>
                                </div>
                                {% endif %}
                            {% endif %}
                        </div>

                        {% elseif type == 'file' %}
                        {% set isMultiple = config.multiple ?? false %}
                        {% set storedValue = value is iterable ? (value|json_encode|e('html_attr')) : (value|e('html_attr')) %}
                        <input type="hidden" name="{{ field }}" value="{{ storedValue }}" id="upload-value-{{ resource }}-{{ field }}">
                        <button type="button" class="layui-btn layui-btn-sm" id="upload-btn-{{ resource }}-{{ field }}"
                                data-field="{{ field }}" data-type="file" data-multiple="{{ isMultiple ? '1' : '0' }}">
                            <i class="layui-icon layui-icon-upload"></i> 上传文件
                        </button>
                        <div class="layui-upload-list upload-preview upload-preview-file" id="upload-preview-{{ resource }}-{{ field }}">
                            {% if isMultiple %}
                                {% set fileList = value is iterable ? value : [] %}
                                {% for f in fileList %}
                                    {% if f %}
                                    <div class="upload-item" data-url="{{ f }}">
                                        <a href="{{ f }}" target="_blank">{{ f }}</a>
                                        <a href="javascript:;" class="upload-del"><i class="layui-icon layui-icon-close"></i></a>
                                    </div>
                                    {% endif %}
                                {% endfor %}
                            {% else %}
                                {% if value %}
                                <div class="upload-item" data-url="{{ value }}">
                                    <a href="{{ value }}" target="_blank">{{ value }}</a>
                                    <a href="javascript:;" class="upload-del"><i class="layui-icon layui-icon-close"></i></a>
                                </div>
                                {% endif %}
                            {% endif %}
                        </div>

                        {% elseif type == 'richtext' %}
                        <div class="w-e-wrapper" data-richtext-field="{{ field }}">
                            <div class="w-e-toolbar-container" id="w-e-toolbar-{{ resource }}-{{ field }}"></div>
                            <div class="w-e-text-container" id="w-e-editor-{{ resource }}-{{ field }}"></div>
                        </div>
                        <textarea name="{{ field }}" id="w-e-textarea-{{ resource }}-{{ field }}" style="display:none;">{{ value }}</textarea>

                        {% else %}
                        <input type="text" name="{{ field }}" value="{{ value }}" class="layui-input"{% if layVerify %} lay-verify="{{ layVerify }}"{% endif %}>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}

                <div class="layui-form-item">
                    <div class="layui-input-block">
                        <button type="submit" class="layui-btn" lay-submit lay-filter="crud-submit-{{ resource }}">保存</button>
                        <button type="button" class="layui-btn layui-btn-primary" id="back-btn-{{ resource }}">返回</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
layui.use(['jquery', 'form', 'layer', 'admin', 'upload'], function () {
    var $ = layui.jquery;
    var form = layui.form;
    var layer = layui.layer;
    var admin = layui.admin;
    var upload = layui.upload;

    var resource = '{{ resource }}';
    var title = '{{ admin.getTitle() }}';
    var isEdit = {{ action == 'edit' ? 'true' : 'false' }};
    var editId = {{ data.id ?? 0 }};

    // 定向渲染当前表单（延迟执行确保动态加载的 DOM 就绪）
    setTimeout(function () {
        form.render(null, 'crud-form-' + resource);
    }, 50);

    // 初始化富文本编辑器（wangEditor-next）
    var richtextEditors = {};
    document.querySelectorAll('.w-e-wrapper').forEach(function (wrapper) {
        var field = wrapper.getAttribute('data-richtext-field');
        var toolbarId = '#w-e-toolbar-' + resource + '-' + field;
        var editorId = '#w-e-editor-' + resource + '-' + field;
        var textarea = document.getElementById('w-e-textarea-' + resource + '-' + field);
        var html = textarea ? textarea.value : '';

        if (!window.wangEditor) {
            return;
        }

        var createEditor = window.wangEditor.createEditor;
        var createToolbar = window.wangEditor.createToolbar;

        var editorConfig = {
            placeholder: '请输入内容...',
            MENU_CONF: {
                uploadImage: {
                    server: '/admin/upload',
                    fieldName: 'file',
                    withCredentials: true,
                    customInsert: function (res, insertFn) {
                        insertFn(res.data.url, res.data.alt || '', res.data.href || '');
                    }
                }
            },
            onChange: function (editor) {
                if (textarea) {
                    textarea.value = editor.getHtml();
                }
            }
        };

        var editor = createEditor({
            selector: editorId,
            html: html || '<p><br></p>',
            config: editorConfig,
            mode: 'default'
        });

        createToolbar({
            editor: editor,
            selector: toolbarId,
            config: {},
            mode: 'default'
        });

        richtextEditors[field] = editor;
    });

    // 初始化 layui 上传组件（图片 / 文件，单文件 / 多文件）
    document.querySelectorAll('[id^="upload-btn-"]').forEach(function (btn) {
        var field = btn.getAttribute('data-field');
        var ftype = btn.getAttribute('data-type');
        var multiple = btn.getAttribute('data-multiple') === '1';
        var valueInput = document.getElementById('upload-value-' + resource + '-' + field);
        var previewBox = document.getElementById('upload-preview-' + resource + '-' + field);

        // 读取已存储的值
        function getStoredUrls() {
            var raw = valueInput.value;
            if (!raw) return [];
            if (multiple) {
                try {
                    var arr = JSON.parse(raw);
                    return Array.isArray(arr) ? arr : [];
                } catch (e) { return []; }
            }
            return raw ? [raw] : [];
        }

        function saveUrls(urls) {
            if (multiple) {
                valueInput.value = JSON.stringify(urls);
            } else {
                valueInput.value = urls.length ? urls[0] : '';
            }
        }

        function renderPreview(urls) {
            previewBox.innerHTML = '';
            urls.forEach(function (url) {
                if (!url) return;
                var item = document.createElement('div');
                item.className = 'upload-item';
                item.setAttribute('data-url', url);
                if (ftype === 'image') {
                    item.innerHTML = '<img src="' + url + '" class="layui-upload-img">' +
                        '<a href="javascript:;" class="upload-del"><i class="layui-icon layui-icon-close"></i></a>';
                } else {
                    item.innerHTML = '<a href="' + url + '" target="_blank">' + url + '</a>' +
                        '<a href="javascript:;" class="upload-del"><i class="layui-icon layui-icon-close"></i></a>';
                }
                previewBox.appendChild(item);
            });
        }

        // 已存在值的预览
        renderPreview(getStoredUrls());

        // 绑定删除
        previewBox.addEventListener('click', function (e) {
            var del = e.target.closest('.upload-del');
            if (!del) return;
            var item = del.closest('.upload-item');
            if (!item) return;
            var url = item.getAttribute('data-url');
            var urls = getStoredUrls().filter(function (u) { return u !== url; });
            saveUrls(urls);
            renderPreview(urls);
        });

        upload.render({
            elem: '#' + btn.id,
            url: '/admin/upload',
            field: 'file',
            accept: ftype === 'image' ? 'images' : 'file',
            multiple: multiple,
            before: function () {
                layer.msg('上传中...', { icon: 16, time: 0 });
            },
            done: function (res) {
                layer.closeAll();
                if (res.errno !== 0 || !res.data || !res.data.url) {
                    layer.msg(res.message || '上传失败', { icon: 2 });
                    return;
                }
                var url = res.data.url;
                var urls = getStoredUrls();
                if (multiple) {
                    urls.push(url);
                } else {
                    urls = [url];
                }
                saveUrls(urls);
                renderPreview(urls);
                layer.msg('上传成功', { icon: 1 });
            },
            error: function () {
                layer.closeAll();
                layer.msg('上传失败', { icon: 2 });
            }
        });
    });

    // 返回：关闭当前标签页，回到列表，并刷新列表数据
    function backToList() {
        var tabFilter = $('.layui-tab[lay-filter="content"]');
        var currentTabId = tabFilter.find('.layui-tab-title .layui-this').attr('lay-id');
        var listTabExists = tabFilter.find('.layui-tab-title li[lay-id="' + resource + '"]').length > 0;

        if (listTabExists && currentTabId) {
            // 列表标签页存在，关闭当前标签页后 pear-admin 自动切回列表页，再刷新
            admin.instances.tabPage.removeTab(currentTabId);
            setTimeout(function () {
                admin.instances.tabPage.refresh(false);
            }, 100);
        } else {
            // 列表标签页不存在，切换到列表页（changePage 本身会重新加载）
            admin.changePage({
                id: resource,
                title: title,
                url: '/admin/' + resource,
                type: '_component'
            });
        }
    }

    document.getElementById('back-btn-' + resource).addEventListener('click', backToList);

    // 使用 layui 的 submit 事件，自动触发 lay-verify 校验
    form.on('submit(crud-submit-' + resource + ')', function (data) {
        var formEl = data.form;

        // 提交前同步富文本编辑器内容到隐藏 textarea
        Object.keys(richtextEditors).forEach(function (field) {
            var textarea = document.getElementById('w-e-textarea-' + resource + '-' + field);
            if (textarea) {
                textarea.value = richtextEditors[field].getHtml();
            }
        });

        var formData = new FormData(formEl);

        var url = isEdit ? '/admin/' + resource + '/' + editId : '/admin/' + resource;
        var method = isEdit ? 'PUT' : 'POST';

        // 所有字段均为字符串（上传组件已通过 AJAX 上传并将 URL 存入隐藏域），统一使用 urlencoded 提交
        var params = new URLSearchParams();
        for (var pair of formData.entries()) {
            if (pair[1] !== '') params.append(pair[0], pair[1]);
        }

        fetch(url, {
            method: method,
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: params.toString()
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
            if (res.code === 200) {
                layer.msg('保存成功', { icon: 1, time: 800 }, function () {
                    backToList();
                });
            } else {
                layer.msg(res.msg || '保存失败', { icon: 2 });
            }
        })
        .catch(function () { layer.msg('网络错误', { icon: 2 }); });

        return false; // 阻止表单默认提交
    });
});
</script>
